{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist",
    "apps/web/src/ui",
    "apps/web/src/components/ai-elements",
    "apps/web/src/hooks/use-mobile.ts",
    "apps/web/src/hooks/use-highlighted-code.ts",
    "apps/web/src/lib/highlighter.tsx",
    "apps/web/src/paraglide",
    "apps/web/src/routeTree.gen.ts",
    "packages/api-client/src/generated"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/mobile/*"],
                "message": "Desktop code does not use the phone UI (M17). Only manifests (`mobile.component`), the Program route and the registry load it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/modules/*/manifest.ts",
        "apps/web/src/routes/_authed.p.$programId.tsx",
        "apps/web/src/app/registry.ts",
        "apps/web/src/**/*.test.{ts,tsx}"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/web/src/**/mobile/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/pages/*",
                  "**/cards/*",
                  "@/app/board/*",
                  "@/modules/academics/shell/*"
                ],
                "message": "Phone pages reuse data and logic, not desktop pages, cards or the desktop shell (M17)."
              }
            ]
          }
        ]
      }
    }
  ]
}
