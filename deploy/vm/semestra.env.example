# Production environment for the API on a single small VM (uv + systemd, see README.md).
# Copy to /etc/semestra/semestra.env on the VM (root:semestra, chmod 640), fill in the blanks,
# never commit the result. The complete variable reference is deploy/.env.example.

SEMESTRA_ENV=prod
SEMESTRA_LOG_LEVEL=INFO
SEMESTRA_SECRET_KEY=
SEMESTRA_ENCRYPTION_KEY=              # BACK THIS UP OFFLINE

# Data on the boot disk; Litestream replicates the databases, a timer mirrors the files.
SEMESTRA_DATA_DIR=/var/lib/semestra
SEMESTRA_DATABASE_URL=sqlite+aiosqlite:////var/lib/semestra/semestra.db
SEMESTRA_STORAGE_LOCAL_ROOT=/var/lib/semestra/storage

# The web app is on Vercel, the API on its own subdomain. Both are under jyleo.cc, so they are
# the same site: the cookies are set for the parent domain so the web app can read the CSRF cookie.
SEMESTRA_PUBLIC_WEB_ORIGIN=https://semestra.jyleo.cc
SEMESTRA_PUBLIC_API_ORIGIN=https://semestra-api.jyleo.cc
SEMESTRA_CORS_ORIGINS=["https://semestra.jyleo.cc"]
SEMESTRA_COOKIE_DOMAIN=jyleo.cc
SEMESTRA_SERVE_WEB=false
# Cloudflare's edge -> cloudflared -> uvicorn: the client IP is the last X-Forwarded-For entry.
SEMESTRA_TRUSTED_PROXY_HOPS=1

SEMESTRA_EMAIL_BACKEND=resend
SEMESTRA_RESEND_API_KEY=
SEMESTRA_EMAIL_FROM=Semestra <no-reply@semestra.jyleo.cc>
SEMESTRA_GOOGLE_CLIENT_ID=

# Sized for an e2-micro (1 GB RAM + 2 GB swap).
SEMESTRA_JOB_CONCURRENCY=1
SEMESTRA_FILES_PARSE_MEMORY_BYTES=1073741824
SEMESTRA_USER_STORAGE_QUOTA_BYTES=52428800
SEMESTRA_ALLOW_PRIVATE_EGRESS=false
SEMESTRA_SENTRY_DSN=
