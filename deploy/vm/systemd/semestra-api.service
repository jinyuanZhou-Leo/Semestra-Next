[Unit]
Description=Semestra API (uvicorn)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=semestra
Group=semestra
# Settings come from /var/lib/semestra/.env, a symlink to /etc/semestra/semestra.env that the
# API reads itself (pydantic-settings), so deploy-time commands see exactly the same values.
WorkingDirectory=/var/lib/semestra
# uvicorn trusts X-Forwarded-* only from loopback, which is where cloudflared connects from.
ExecStart=/opt/semestra/current/apps/api/.venv/bin/semestra serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# The e2-micro has 1 GB of RAM; let the kernel reclaim from this unit before the OOM killer runs.
MemoryHigh=650M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/semestra

[Install]
WantedBy=multi-user.target
