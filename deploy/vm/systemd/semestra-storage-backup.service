[Unit]
Description=Mirror Semestra uploaded files to GCS
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/semestra/backup.env
ExecStartPre=/usr/bin/test -d /var/lib/semestra/storage
# Deleted files stay recoverable for 30 days through bucket versioning (deploy/hosted/gcs-lifecycle.json).
ExecStart=/usr/bin/gcloud storage rsync --recursive --delete-unmatched-destination-objects /var/lib/semestra/storage gs://${BACKUP_BUCKET}/storage
