# Backend settings. Every variable uses the SEMESTRA_ prefix (see apps/api/src/semestra/core/config.py).
SEMESTRA_ENV=dev                      # dev | test | prod
SEMESTRA_LOG_LEVEL=INFO
SEMESTRA_DATA_DIR=./data
SEMESTRA_DATABASE_URL=sqlite+aiosqlite:///./data/semestra.db
# Required in prod. SECRET_KEY signs tokens; ENCRYPTION_KEY is a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEMESTRA_SECRET_KEY=
SEMESTRA_ENCRYPTION_KEY=
SEMESTRA_PUBLIC_WEB_ORIGIN=http://localhost:5173
SEMESTRA_PUBLIC_API_ORIGIN=http://localhost:8000
SEMESTRA_CORS_ORIGINS=["http://localhost:5173"]
SEMESTRA_STORAGE_BACKEND=local
SEMESTRA_STORAGE_LOCAL_ROOT=./data/storage
SEMESTRA_USER_STORAGE_QUOTA_BYTES=52428800
SEMESTRA_COOKIE_DOMAIN=               # hosted: .semestra.jyleo.cc (shared by web and api); empty in dev
SEMESTRA_COOKIE_SECURE=               # empty = Secure when PUBLIC_API_ORIGIN is https
SEMESTRA_TRUSTED_PROXY_HOPS=0         # reverse proxies in front of the API (client IP from X-Forwarded-For)
# Email (M01). console logs to the API log (and data/dev-outbox.jsonl outside prod).
SEMESTRA_EMAIL_BACKEND=console        # console | smtp | resend
SEMESTRA_EMAIL_FROM=Semestra <no-reply@semestra.jyleo.cc>
SEMESTRA_RESEND_API_KEY=
SEMESTRA_SMTP_HOST=
SEMESTRA_SMTP_PORT=587
SEMESTRA_SMTP_USERNAME=
SEMESTRA_SMTP_PASSWORD=
SEMESTRA_SMTP_STARTTLS=true
SEMESTRA_NOTIFY_NEW_SIGN_IN=false     # email on sign-in from a new session
# Sessions and tokens (M01)
SEMESTRA_SESSION_TTL_DAYS=30
SEMESTRA_ACCESS_TOKEN_TTL_SECONDS=900
SEMESTRA_REFRESH_TOKEN_TTL_DAYS=60
SEMESTRA_GOOGLE_CLIENT_ID=            # empty hides the Google button
