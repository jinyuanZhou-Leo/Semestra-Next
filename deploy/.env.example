# Backend settings. Every variable uses the SEMESTRA_ prefix (see apps/api/src/semestra/core/config.py).
# Defaults below are for local development; hosted/ and selfhost/ carry ready-to-edit production versions.
# Lines marked "(reserved)" are part of the deployment contract in docs/specs/M15 but are read by
# a module that is not merged yet; setting them early is harmless.

# --- core -------------------------------------------------------------------------------------
SEMESTRA_ENV=dev                      # dev | test | prod. prod refuses to start without real keys.
SEMESTRA_LOG_LEVEL=INFO
SEMESTRA_DATA_DIR=./data
SEMESTRA_DATABASE_URL=sqlite+aiosqlite:///./data/semestra.db

# Required in prod. SECRET_KEY signs tokens; ENCRYPTION_KEY is a Fernet key that encrypts the
# API keys users store. LOSING ENCRYPTION_KEY MAKES THOSE KEYS UNRECOVERABLE: back it up offline.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SEMESTRA_SECRET_KEY=
SEMESTRA_ENCRYPTION_KEY=

# --- origins and cookies ----------------------------------------------------------------------
# Hosted: web https://semestra.jyleo.cc, API https://api.semestra.jyleo.cc, cookie domain
# .semestra.jyleo.cc. All-in-one / self-hosted: both origins are the same URL, no cookie domain.
SEMESTRA_PUBLIC_WEB_ORIGIN=http://localhost:5173
SEMESTRA_PUBLIC_API_ORIGIN=http://localhost:8000
SEMESTRA_CORS_ORIGINS=["http://localhost:5173"]   # JSON list
SEMESTRA_COOKIE_DOMAIN=

# --- storage ----------------------------------------------------------------------------------
SEMESTRA_STORAGE_BACKEND=local
SEMESTRA_STORAGE_LOCAL_ROOT=./data/storage
SEMESTRA_USER_STORAGE_QUOTA_BYTES=52428800   # per user; 0 = unlimited (self-hosting default)

# --- auth (M01) -------------------------------------------------------------------------------
# Optional (leave unset, not empty): the cookie domain shared by web and api when hosted, e.g. .semestra.jyleo.cc
# SEMESTRA_COOKIE_DOMAIN=
# Optional: true/false. Unset = Secure when PUBLIC_API_ORIGIN is https.
# SEMESTRA_COOKIE_SECURE=
SEMESTRA_TRUSTED_PROXY_HOPS=0         # reverse proxies in front of the API (client IP from X-Forwarded-For)
SEMESTRA_SESSION_TTL_DAYS=30
SEMESTRA_ACCESS_TOKEN_TTL_SECONDS=900
SEMESTRA_REFRESH_TOKEN_TTL_DAYS=60
SEMESTRA_NOTIFY_NEW_SIGN_IN=false     # email on sign-in from a new session

# --- email ------------------------------------------------------------------------------------
# console logs codes to the API log (and data/dev-outbox.jsonl outside prod).
# Hosted: SEMESTRA_EMAIL_BACKEND=resend, with the same Resend account and verified sending domain
# as the old Semestra (old RESEND_API_KEY -> SEMESTRA_RESEND_API_KEY, AUTH_EMAIL_FROM ->
# SEMESTRA_EMAIL_FROM, AUTH_EMAIL_REPLY_TO -> SEMESTRA_EMAIL_REPLY_TO). Fill the key in the server
# .env only; the API refuses to start with backend=resend and an empty key.
SEMESTRA_EMAIL_BACKEND=console        # console | smtp | resend
SEMESTRA_EMAIL_FROM=Semestra <no-reply@semestra.jyleo.cc>
# SEMESTRA_EMAIL_REPLY_TO=support@example.com
SEMESTRA_RESEND_API_KEY=
SEMESTRA_SMTP_HOST=
SEMESTRA_SMTP_PORT=587
SEMESTRA_SMTP_USERNAME=
SEMESTRA_SMTP_PASSWORD=
SEMESTRA_SMTP_STARTTLS=true
SEMESTRA_GOOGLE_CLIENT_ID=            # empty hides the Google button

# --- runtime ----------------------------------------------------------------------------------
SEMESTRA_JOB_CONCURRENCY=2            # (reserved) background job workers per process
SEMESTRA_ALLOW_PRIVATE_EGRESS=false   # (reserved) true lets the server call private IPs (LAN Ollama/Canvas)
SEMESTRA_SINGLE_USER=false            # (reserved) self-hosting: first visitor becomes admin, then sign-up closes

# --- deployment (M15) -------------------------------------------------------------------------
SEMESTRA_SERVE_WEB=false              # serve the built SPA from the API process (all-in-one image sets true)
SEMESTRA_WEB_DIST_DIR=./web           # where the built SPA lives when SERVE_WEB=true
SEMESTRA_SENTRY_DSN=                  # empty disables error tracking; request bodies are never sent
SEMESTRA_BACKUP_DIR=                  # set to enable the built-in daily backup (databases + files) into this directory
SEMESTRA_BACKUP_KEEP=7                # database snapshots kept per database

# Entrypoint switches (container only, not part of Settings):
#   SEMESTRA_AUTO_SECRETS=true     generate the two keys into $DATA_DIR/secrets.env on first start
#   SEMESTRA_SKIP_MIGRATIONS=true  do not run `alembic upgrade head` on start
