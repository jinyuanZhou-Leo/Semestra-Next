[Unit]
Description=Mirror Semestra uploaded files to GCS
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/semestra/backup.env
ExecStartPre=/usr/bin/test -d /srv/semestra/data/storage
# Deleted files stay recoverable for 30 days through bucket versioning (see gcs-lifecycle.json).
ExecStart=/usr/bin/docker run --rm -v /srv/semestra/data/storage:/storage:ro google/cloud-sdk:slim gcloud storage rsync --recursive --delete-unmatched-destination-objects /storage gs://${BACKUP_BUCKET}/storage
