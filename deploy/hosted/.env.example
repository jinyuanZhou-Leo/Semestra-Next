# Production environment for the hosted stack: copy to /srv/semestra/app/.env on the VM
# (chmod 600), fill in the blanks, never commit the result. Used both for `docker compose`
# interpolation and as the API container's env file. The complete variable reference is
# deploy/.env.example.

# --- compose / Caddy / Litestream --------------------------------------------------------------
SEMESTRA_IMAGE_TAG=latest             # written by deploy.sh; do not edit by hand
SEMESTRA_STAGING_IMAGE_TAG=latest
SEMESTRA_DOMAIN=semestra.jyleo.cc     # the app, /docs and /landing all live here
ACME_EMAIL=                           # Let's Encrypt expiry notices go here
BACKUP_BUCKET=semestra-backups

# --- API ---------------------------------------------------------------------------------------
SEMESTRA_ENV=prod
SEMESTRA_LOG_LEVEL=INFO
SEMESTRA_SECRET_KEY=
SEMESTRA_ENCRYPTION_KEY=              # BACK THIS UP OFFLINE
SEMESTRA_PUBLIC_WEB_ORIGIN=https://semestra.jyleo.cc
SEMESTRA_PUBLIC_API_ORIGIN=https://semestra.jyleo.cc
SEMESTRA_CORS_ORIGINS=[]              # same origin: no cross-origin callers
SEMESTRA_EMAIL_BACKEND=resend
SEMESTRA_RESEND_API_KEY=
SEMESTRA_EMAIL_FROM=Semestra <no-reply@semestra.jyleo.cc>
SEMESTRA_GOOGLE_CLIENT_ID=
SEMESTRA_USER_STORAGE_QUOTA_BYTES=52428800
SEMESTRA_JOB_CONCURRENCY=2
SEMESTRA_ALLOW_PRIVATE_EGRESS=false
SEMESTRA_SENTRY_DSN=
