# Copy to .env. Everything is optional; the defaults give you a working instance on port 8000.

# Image version, e.g. 1.2.0. "latest" follows the newest release.
SEMESTRA_VERSION=latest
# The default image reads scanned pages on this machine (PaddleOCR, models included). Uncomment
# for the smaller image without it; users then pick a provider's model for "OCR" in AI settings.
# SEMESTRA_IMAGE_VARIANT=

# --- where the instance is reachable ------------------------------------------------------------
# The URL users type in the browser. Change this when you put it behind a domain.
SEMESTRA_PUBLIC_URL=http://localhost:8000
SEMESTRA_PORT=8000
# Use 127.0.0.1 when a reverse proxy (the bundled Caddy or your own) sits in front.
SEMESTRA_BIND=0.0.0.0
# Only for `--profile https`: the domain Caddy should get a certificate for.
# (Then also set SEMESTRA_PUBLIC_URL=https://<that domain> and SEMESTRA_BIND=127.0.0.1.)
SEMESTRA_DOMAIN=

# --- accounts and email -------------------------------------------------------------------------
# Single-user mode (planned, not implemented yet; this has no effect): the first visitor will
# create the admin account (email + password), after which sign-up closes.
SEMESTRA_SINGLE_USER=false
# console prints verification codes to `docker compose logs semestra`. For real email use smtp
# (or resend) and the matching settings from deploy/.env.example.
SEMESTRA_EMAIL_BACKEND=console

# --- limits -------------------------------------------------------------------------------------
SEMESTRA_USER_STORAGE_QUOTA_BYTES=0   # per user, 0 = unlimited
SEMESTRA_ALLOW_PRIVATE_EGRESS=true    # lets the server reach machines on your LAN (Ollama, Canvas)

# --- backups ------------------------------------------------------------------------------------
# Enable the daily built-in backup after uncommenting the /backups mount in docker-compose.yml.
# SEMESTRA_BACKUP_DIR=/backups
# SEMESTRA_BACKUP_KEEP=7

# --- AI (optional) ------------------------------------------------------------------------------
# An instance-wide provider that every user falls back to when they have not added their own key.
# With `--profile ai-local` the bundled Ollama is at http://ollama:11434; pull models first:
#   docker compose exec ollama ollama pull qwen3:8b
#   docker compose exec ollama ollama pull nomic-embed-text
# SEMESTRA_INSTANCE_AI_KIND=ollama
# SEMESTRA_INSTANCE_AI_BASE_URL=http://ollama:11434
# SEMESTRA_INSTANCE_AI_CHAT_MODEL=qwen3:8b
# SEMESTRA_INSTANCE_AI_EMBEDDING_MODEL=nomic-embed-text
