# Copy to .env. Everything is optional; the defaults give you a working instance on port 8000.

# Image version, e.g. 1.2.0. "latest" follows the newest release.
SEMESTRA_VERSION=latest
# The default image reads scanned pages on this machine (PaddleOCR; each model downloads into the
# data volume the first time it is needed). Uncomment for the smaller image without it; users then
# pick a provider's model for "OCR" in AI settings.
# SEMESTRA_IMAGE_VARIANT=

# --- where the instance is reachable ------------------------------------------------------------
# The URL users type in the browser. Change this when you put it behind a domain.
SEMESTRA_PUBLIC_URL=http://localhost:8000
SEMESTRA_PORT=8000
# Behind a reverse proxy (the bundled Caddy or your own): SEMESTRA_BIND=127.0.0.1 so clients
# cannot bypass it, and SEMESTRA_TRUSTED_PROXY_HOPS=1 so sign-in limits see the real client address.
SEMESTRA_BIND=0.0.0.0
SEMESTRA_TRUSTED_PROXY_HOPS=0
# Bundled extras: https (Caddy with automatic HTTPS), ai-local (Ollama); comma-separated.
# COMPOSE_PROFILES=https
# With https: the domain Caddy gets a certificate for. Then also set
# SEMESTRA_PUBLIC_URL=https://<that domain>, SEMESTRA_BIND=127.0.0.1 and SEMESTRA_TRUSTED_PROXY_HOPS=1.
SEMESTRA_DOMAIN=

# --- accounts and email -------------------------------------------------------------------------
# Once email works, anyone who can reach the instance can sign up. For a public instance only you
# use, keep it behind your own access control.
# console prints verification codes to `docker compose logs semestra`. For real email use smtp
# (or resend) and the matching settings from deploy/.env.example.
SEMESTRA_EMAIL_BACKEND=console

# --- limits -------------------------------------------------------------------------------------
SEMESTRA_USER_STORAGE_QUOTA_BYTES=0   # per user, 0 = unlimited
# Lets the server reach machines on your network (LAN Ollama, on-premises Canvas). Every user
# can then point a provider or Canvas address at them; set false for an instance open to strangers.
# Link-local and cloud metadata addresses stay blocked either way.
SEMESTRA_ALLOW_PRIVATE_EGRESS=true
# SEMESTRA_LMS_CANVAS_SIGN_IN=true    # connect Canvas by signing in on the school's page (permanent refresh token)

# --- backups ------------------------------------------------------------------------------------
# Enable the daily built-in backup after uncommenting the /backups mount in docker-compose.yml.
# SEMESTRA_BACKUP_DIR=/backups
# SEMESTRA_BACKUP_KEEP=7

# --- AI (optional) ------------------------------------------------------------------------------
# An instance-wide provider that every user falls back to when they have not added their own key.
# With `--profile ai-local` the bundled Ollama is at http://ollama:11434; pull models first:
#   docker compose exec ollama ollama pull qwen3:8b
#   docker compose exec ollama ollama pull nomic-embed-text
# SEMESTRA_INSTANCE_AI_KIND=ollama
# SEMESTRA_INSTANCE_AI_BASE_URL=http://ollama:11434
# SEMESTRA_INSTANCE_AI_CHAT_MODEL=qwen3:8b
# SEMESTRA_INSTANCE_AI_EMBEDDING_MODEL=nomic-embed-text
