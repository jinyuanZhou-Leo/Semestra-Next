VITE_API_ORIGIN=http://localhost:8000

# Optional: comma-separated domains suggested after "@" on the login page.
# VITE_EMAIL_DOMAINS=gmail.com,outlook.com,mail.utoronto.ca
# Optional: browser error tracking (leave empty to disable)
VITE_SENTRY_DSN=
# Optional: where signed-out visitors to / go instead of the login page (the hosted service's
# landing page, e.g. /landing/ in production or http://localhost:4321/landing/ with `pnpm site:dev`).
# VITE_LANDING_URL=
# Optional: the docs linked from Settings › About (default: the public docs).
# VITE_DOCS_URL=http://localhost:3001/docs
