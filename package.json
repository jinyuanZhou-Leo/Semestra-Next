{
  "name": "semestra-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @semestra/web --filter @semestra/api dev",
    "build": "pnpm --filter @semestra/web build",
    "docs:dev": "pnpm --filter @semestra/docs dev",
    "docs:build": "pnpm --filter @semestra/docs build",
    "lint": "pnpm --filter @semestra/web lint && pnpm --filter @semestra/api lint && pnpm --filter @semestra/docs lint",
    "format": "pnpm --filter @semestra/web format && pnpm --filter @semestra/api format",
    "typecheck": "pnpm --filter @semestra/web typecheck && pnpm --filter @semestra/api typecheck && pnpm --filter @semestra/docs typecheck",
    "test": "pnpm --filter @semestra/web test && pnpm --filter @semestra/api test",
    "gen:api": "pnpm --filter @semestra/api openapi && pnpm --filter @semestra/api-client generate",
    "site:dev": "pnpm --filter @semestra/site dev",
    "site:build": "pnpm --filter @semestra/site build",
    "changeset": "changeset",
    "release:check": "node scripts/release.mjs check",
    "release:version": "node scripts/release.mjs version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/get-release-plan": "5.0.2",
    "@changesets/read": "1.0.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
